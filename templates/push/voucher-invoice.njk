<ENVELOPE>
    <HEADER><VERSION>1</VERSION><TALLYREQUEST>Import</TALLYREQUEST><TYPE>Data</TYPE><ID>Vouchers</ID></HEADER>
    <BODY><DESC><STATICVARIABLES><SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT>
        {% if targetCompany %}<SVCURRENTCOMPANY>{{ targetCompany | escape }}</SVCURRENTCOMPANY>{% endif %}
    </STATICVARIABLES></DESC><DATA>
        <TALLYMESSAGE xmlns:UDF="TallyUDF">
            <VOUCHER REMOTEID="{{ remoteId | escape }}" VCHTYPE="{{ voucherType | escape }}" ACTION="Create">
                <DATE>{{ date | formatDate("yyyyMMdd") }}</DATE>
                <EFFECTIVEDATE>{{ date | formatDate("yyyyMMdd") }}</EFFECTIVEDATE>
                <VOUCHERTYPENAME>{{ voucherType | escape }}</VOUCHERTYPENAME>
                <PARTYLEDGERNAME>{{ partyLedger | escape }}</PARTYLEDGERNAME>
                {% if voucherNumber %}<VOUCHERNUMBER>{{ voucherNumber | escape }}</VOUCHERNUMBER>{% endif %}
                {% if reference %}<REFERENCE>{{ reference | escape }}</REFERENCE>{% endif %}
                {% if narration %}<NARRATION>{{ narration | escape }}</NARRATION>{% endif %}
                <ISINVOICE>Yes</ISINVOICE>
                {% for it in items %}<ALLINVENTORYENTRIES.LIST>
                    <STOCKITEMNAME>{{ it.stockItemName | escape }}</STOCKITEMNAME>
                    <ISDEEMEDPOSITIVE>{{ it.deemedPositive }}</ISDEEMEDPOSITIVE>
                    <RATE>{{ it.rate }}/{{ it.unit | escape }}</RATE>
                    <AMOUNT>{{ it.amountStr }}</AMOUNT>
                    <ACTUALQTY>{{ it.qty }} {{ it.unit | escape }}</ACTUALQTY>
                    <BILLEDQTY>{{ it.qty }} {{ it.unit | escape }}</BILLEDQTY>
                    <ACCOUNTINGALLOCATIONS.LIST>
                        <LEDGERNAME>{{ it.itemLedger | escape }}</LEDGERNAME>
                        <ISDEEMEDPOSITIVE>{{ it.deemedPositive }}</ISDEEMEDPOSITIVE>
                        <AMOUNT>{{ it.amountStr }}</AMOUNT>
                    </ACCOUNTINGALLOCATIONS.LIST>
                </ALLINVENTORYENTRIES.LIST>{% endfor %}
                <LEDGERENTRIES.LIST>
                    <LEDGERNAME>{{ partyLedger | escape }}</LEDGERNAME>
                    <ISDEEMEDPOSITIVE>{{ partyDeemedPositive }}</ISDEEMEDPOSITIVE>
                    <AMOUNT>{{ partyAmountStr }}</AMOUNT>
                </LEDGERENTRIES.LIST>
                {% for t in taxes %}<LEDGERENTRIES.LIST>
                    <LEDGERNAME>{{ t.ledger | escape }}</LEDGERNAME>
                    <ISDEEMEDPOSITIVE>{{ t.deemedPositive }}</ISDEEMEDPOSITIVE>
                    <AMOUNT>{{ t.amountStr }}</AMOUNT>
                </LEDGERENTRIES.LIST>{% endfor %}
            </VOUCHER>
        </TALLYMESSAGE>
    </DATA></BODY>
</ENVELOPE>
